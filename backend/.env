# PeoplePay360 — committed dev defaults. You should not need to edit anything.
# docker compose overrides the two host names (postgres/redis); everything else already matches.
# Read by backend/src/config.js — the key names below are exactly what it looks for.
NODE_ENV=development
TZ=Asia/Kolkata

# Postgres (built-in dev credentials). DATABASE_URL wins; the PG* vars are what psql/pg use as fallback.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=peoplepay360
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/peoplepay360

# Redis (no password in dev). Set REDIS_PATH instead of host/port to use a unix socket.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PATH=

# Ports + origins
PORT=4000
WEB_PORT=5173
WORKER_PORT=4100
WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=

# Auth — bcrypt + JWT. The refresh cookie outlives the access token, so an F5 never logs you out.
JWT_SECRET=peoplepay360-dev-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SEC=300
LOGIN_LOCKOUT_SEC=900

# ─── Email (payslips and invitations) — two lines, that is the whole of it ────────────────
# Your Gmail address and its 16-character App Password, and mails send for real. The server is not
# a setting you have to know: smtp.gmail.com on 465 with implicit TLS is what a Gmail address means.
# (Google account → Security → 2-Step Verification → App passwords. The password you type on google.com
#  is refused with "Username and Password not accepted" — that sentence is what the app shows you back.)
# Leave EMAIL_PASSWORD empty and nothing leaves this machine: each mail becomes storage/mail/*.eml.
# The same two boxes are in Settings → Company → E-mail delivery; that wins over this file and needs no restart.
EMAIL_NAME=
EMAIL_PASSWORD=
# Everything below is for a mailbox outside the list the app knows — Google, Microsoft, Zoho, Yahoo,
# Apple, Fastmail, QQ Mail — i.e. a company relay or a host your provider named for you. Only then fill
# the host, and with it the port/TLS pair (a port here beats the address there).
# Do NOT put an example hostname in SMTP_HOST: smtp.yourcompany.example resolves to nothing and the app
# ignores it on purpose, going back to whatever the address implies.
#SMTP_HOST=
#SMTP_PORT=            # 587 = STARTTLS, 465 = implicit TLS (needs SMTP_SECURE=true)
#SMTP_SECURE=
# Force a driver: preview | gmail | smtp | stream. Empty = decide from the credentials above.
#MAIL_DRIVER=
# "From" line. Empty = the address above.
#MAIL_FROM=
# What the app refuses to queue past, so a bulk run cannot get the domain blocked (Gmail: ~500/day).
MAIL_DAILY_LIMIT=200
PDF_RENDERER=pdfkit
WORKER_CONCURRENCY=2

# Demo data
DEMO_PASSWORD=Password@123
SEED_DEMO=true
