# PeoplePay360 — committed dev defaults. You should not need to edit anything.
# docker compose overrides the two host names (postgres/redis); everything else already matches.
# Read by backend/src/config.js — the key names below are exactly what it looks for.
NODE_ENV=development
TZ=Asia/Kolkata

# Postgres (built-in dev credentials). DATABASE_URL wins; the PG* vars are what psql/pg use as fallback.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=peoplepay360
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/peoplepay360

# Redis (no password in dev). Set REDIS_PATH instead of host/port to use a unix socket.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PATH=

# Ports + origins
PORT=4000
WEB_PORT=5173
WORKER_PORT=4100
WEB_ORIGIN=http://localhost:5173
CORS_ORIGINS=

# Auth — bcrypt + JWT. The refresh cookie outlives the access token, so an F5 never logs you out.
JWT_SECRET=peoplepay360-dev-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SEC=300
LOGIN_LOCKOUT_SEC=900

# ─── Email (payslips) ─────────────────────────────────────────────────────────────────────
# Put your Gmail address and its 16-character App Password here and payslip emails send for real.
# (Google Account → Security → 2-Step Verification → App passwords. A normal login password is refused.)
# Leave everything empty and nothing leaves this machine: each mail becomes storage/mail/*.eml.
#
# SIMPLEST: put your email + password on the two lines below and nothing else. Gmail needs no host.
# Both key styles work — fill EITHER one (restart api + worker after editing):
#   Style A (current):  EMAIL_NAME  + EMAIL_PASSWORD        (SMTP_HOST stays empty for Google)
#   Style B (original): SMTP_USER   + SMTP_PASS             (SMTP_HOST stays empty for Google)
EMAIL_NAME=
EMAIL_PASSWORD=
SMTP_USER=
SMTP_PASS=
# Only needed for a non-Google provider (leave MAIL_DRIVER empty and smtp is picked for you).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Force a driver: preview | gmail | smtp | stream. Empty = decide from the credentials above.
MAIL_DRIVER=
# "From" line. Empty = EMAIL_NAME.
MAIL_FROM=
MAIL_DAILY_LIMIT=200
PDF_RENDERER=pdfkit
WORKER_CONCURRENCY=2

# Demo data
DEMO_PASSWORD=Password@123
SEED_DEMO=true
